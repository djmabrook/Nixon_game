[gd_resource type="AudioBusLayout" load_steps=10 format=3]

; The game's mixer. See audio/AUDIO.md before changing it.
;
; Master <- Broadcast   the Watcher: hum, hiss, held tone. Never drained by the stare (it IS the stare).
; Master <- World       everything else. The stare drains it toward a one-bit telephone band.
;   World <- Bed        each region's air. Ducks when giants sound.
;   World <- Near       the little man and what he touches. Small room reverb.
;   World <- Far        giant things: low-passed, vast reverb. Arrives late (see Sound.play_at).
;   World <- Ink        the only music: ink notes and mends. Hall reverb.

[sub_resource type="AudioEffectHardLimiter" id="master_limit"]
ceiling_db = -0.8
release = 0.15

[sub_resource type="AudioEffectLowPassFilter" id="broadcast_speaker"]
cutoff_hz = 9000.0
resonance = 0.6

[sub_resource type="AudioEffectLowPassFilter" id="stare_lowpass"]
cutoff_hz = 20000.0
resonance = 0.75

[sub_resource type="AudioEffectHighPassFilter" id="stare_highpass"]
cutoff_hz = 10.0
resonance = 0.6

[sub_resource type="AudioEffectCompressor" id="bed_duck"]
threshold = -26.0
ratio = 4.0
attack_us = 20000.0
release_ms = 900.0
sidechain = &"Far"

[sub_resource type="AudioEffectReverb" id="near_room"]
predelay_msec = 20.0
room_size = 0.35
damping = 0.6
spread = 0.8
hipass = 0.15
dry = 1.0
wet = 0.12

[sub_resource type="AudioEffectLowPassFilter" id="far_air"]
cutoff_hz = 2200.0
resonance = 0.6

[sub_resource type="AudioEffectReverb" id="far_space"]
predelay_msec = 90.0
predelay_feedback = 0.25
room_size = 0.95
damping = 0.55
spread = 1.0
hipass = 0.0
dry = 1.0
wet = 0.3

[sub_resource type="AudioEffectReverb" id="ink_hall"]
predelay_msec = 60.0
room_size = 0.85
damping = 0.35
spread = 1.0
hipass = 0.2
dry = 1.0
wet = 0.22

